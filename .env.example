# =============================================================================
# UNIVERSITY ERP ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or service-account JSON files to version control!
# =============================================================================

# Server & Frontend Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Cloud Database Configuration
DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# MySQL 8 Database Configuration (MySQL80 Windows Service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_erp
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Google Sheets API Integration (One-Way Reporting Export)
# Path to your downloaded service-account JSON credentials file (relative to server directory or absolute)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service_account.json
# The Spreadsheet ID found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
# Admin secret key to protect manual sync trigger endpoint
SYNC_ADMIN_KEY=your_sync_admin_secret_key_here
